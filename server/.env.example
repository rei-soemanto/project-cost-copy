# Copy to .env and fill in. .env is gitignored.

PORT=3000
NODE_ENV=development

# Postgres connection. Create the database first:
#   "C:\Program Files\PostgreSQL\18\bin\psql.exe" -U postgres -c "CREATE DATABASE costproject;"
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/costproject

# Secret for signing access tokens (JWT). Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Refresh tokens are opaque random strings stored hashed, so they need no secret.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated origins allowed by CORS. The Android app does not need this;
# it only matters for browser clients.
CORS_ORIGINS=http://localhost:3000
