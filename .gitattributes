# Normalize text files to LF in the repository
* text=auto eol=lf

# Scripts that MUST stay LF or they break on Linux/macOS and CI
gradlew         text eol=lf
*.sh            text eol=lf

# Windows-only scripts keep CRLF
gradlew.bat     text eol=crlf
*.bat           text eol=crlf

# Binary files - never touch
*.jar           binary
*.png           binary
*.jpg           binary
*.webp          binary
*.ico           binary
*.keystore      binary
*.jks           binary
